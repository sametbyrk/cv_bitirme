# =============================================================================
# Vitascor Frontend - Environment Variables Template
# =============================================================================

# Database (Prisma ORM with PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST].supabase.com:5432/postgres?pgbouncer=true&connection_limit=1"

# App & API URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"
BACKEND_API_URL="http://127.0.0.1:8000/api/v1"

# Authentication & Security
JWT_SECRET="your-32-character-secret-key"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Supabase Client
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# AI Service
GEMINI_API_KEY="your-gemini-api-key"

# Payments (SaaS - Lemon Squeezy)
LEMON_SQUEEZY_API_KEY="your-lemon-squeezy-api-key"
LEMON_SQUEEZY_STORE_ID="your-store-id"
LEMON_SQUEEZY_WEBHOOK_SECRET="your-webhook-secret"

# Support / Contact Email (Used in Privacy Policy)
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
