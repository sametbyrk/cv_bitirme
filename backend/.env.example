# =============================================================================
# Vitascor Backend - Environment Variables Template
# =============================================================================

PROJECT_NAME="Vitascor API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database (Supabase PostgreSQL with asyncpg)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST].supabase.com:5432/postgres?pgbouncer=true&connection_limit=1"

# Supabase Auth & JWT
SUPABASE_URL="https://[YOUR-PROJECT].supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Google Gemini API
GEMINI_API_KEY="your-gemini-api-key"

# Upstash Redis (Opsiyonel - Rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# CORS Origins
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Tez Kalibrasyon Parametreleri (Ampirik Testler için)
SIMILARITY_THRESHOLD=0.80
REQUIRED_SKILL_WEIGHT=1.0
PREFERRED_SKILL_WEIGHT=0.5
